# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments
.env
.venv
env/
venv/
ENV/

# Pytest / Coverage
.pytest_cache/
.coverage
htmlcov/

# Hugging Face caches (Optional, usually stored in ~/.cache/huggingface)
.cache/

# IDEs
.vscode/
.idea/
*.swp

# Results
# (We might want to ignore intermediate results, but keep the folder structure)
# results/*
# !results/.gitkeep

# Built corpora (potentially large; build locally with scripts/build_corpus.py)
corpus/

# Per-run outputs (results/leaderboard.* at the root stay tracked)
results/runs/

# Raw corpus sources under scripts/raw/:
#  - Save-Page-As asset dirs (images/js) are extraction cruft
scripts/raw/*/*_files/
#  - re-fetchable API downloads can be large (10-Ks are tens of MB); regenerate via the fetchers
scripts/raw/*/fedreg_*
scripts/raw/*/sec_*
#  Manually-saved GAO source HTML is tracked (irreplaceable); manifest.csv is tracked.
