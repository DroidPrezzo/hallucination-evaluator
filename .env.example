# Copy to .env and fill in the keys for the providers you need.
# Never commit .env to the repo.

# OpenAI (for gpt-5.5 and OpenAI-compatible providers)
OPENAI_API_KEY=

# Anthropic (for Claude models)
ANTHROPIC_API_KEY=

# xAI / Grok (referenced via key_env=XAI_API_KEY in model spec)
XAI_API_KEY=

# Moonshot / Kimi K3
MOONSHOT_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# Google Gemini
GEMINI_API_KEY=
